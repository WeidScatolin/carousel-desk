DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
NVIDIA_API_KEY=""
ANTHROPIC_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
PROVIDER_THEME_SUGGESTION="nvidia"
PROVIDER_IMAGE_ANALYSIS="nvidia"
PROVIDER_COPYWRITING="nvidia"
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""

# Authenticates pg_cron/pg_net (Supabase-style) and GitHub Actions calls
# into /api/pipeline/*. Any random secret string.
PUBLISH_API_TOKEN=""
DISCOVERY_API_TOKEN=""

# Instagram Graph API (Instagram Login flow, graph.instagram.com) — used
# by publishCarousel, the comment-to-DM polling pipeline and private
# replies.
# META_GRAPH_API_VERSION: falls back to v26.0 when unset.
META_GRAPH_API_VERSION=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# Comment-to-DM automation (post + keyword -> private reply). Polling-based
# (no webhook): /api/pipeline/process-instagram-comments is called on a
# schedule and queries the Graph API's own comments endpoint directly.
# INSTAGRAM_PRIVATE_REPLIES_ENABLED: feature flag, default OFF. Set to the
#   literal string "true" to send real private replies via the Meta Graph
#   API; any other value (including unset) uses the mock/simulation
#   provider and never makes a real network call.
INSTAGRAM_PRIVATE_REPLIES_ENABLED=""
